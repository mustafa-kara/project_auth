# Copy to .env.local (git-ignored) and fill in real values.
# Never commit real keys. `.env.local` is the only place secrets belong.
# `<PROJECT_REF>` / `<REGION>` are placeholders on purpose — this file must not
# name the live project or its pooler endpoint.

# --- Public (inlined into the browser bundle) -------------------------------
# Access path (c): the signed-in admin's own session.
# NOTE: today the publishable key is only ever read SERVER-side (there is no
# browser Supabase client); the NEXT_PUBLIC_ prefix is kept because the value is
# public by definition and a future client component would need it.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Server only (NEVER prefix these with NEXT_PUBLIC_) ---------------------
# Access path (b): Dashboard > Settings > API Keys > secret key.
# Bypasses RLS. Used for auth.admin.* and service-role writes only.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Access path (a): direct Postgres, as the operator-created login role `admin_app`
# (which holds `admin_backend` via GRANT). NEVER the `postgres` superuser.
# Supavisor transaction mode (port 6543) — `SET LOCAL ROLE` is transaction-scoped
# and safe there; the driver runs with prepared statements disabled.
# Session mode (port 5432) also works.
DATABASE_URL=postgres://admin_app.<PROJECT_REF>:PASSWORD@<REGION>.pooler.supabase.com:6543/postgres

# CA certificate for the Postgres connection, PEM. Optional in the schema so the
# panel boots without access path (a) — but REQUIRED in practice: the connection
# uses `rejectUnauthorized: true` (never `ssl: 'require'`, which disables
# verification), and the pooler chain is rooted at Supabase's own PRIVATE
# "Supabase Root 2021 CA", which is in no public trust store.
# Download: Dashboard > Database > SSL Configuration ("Download certificate").
# Literal `\n` sequences are converted to real newlines, so a one-line value works.
SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n"
